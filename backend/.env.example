# Copy to backend/.env and fill in. All values are optional.

# LLM for both co-pilots. Build the local context-sized variant from qwen3:8b before use.
LLM_PROVIDER=ollama          # ollama | anthropic
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
LLM_MODEL=qwen3:8b-rm
LLM_TIMEOUT=120
SUGGESTION_TIMEOUT=180
CHAT_CACHE_ENABLED=1
CHAT_CACHE_TTL_SECONDS=86400
CHAT_CACHE_MAX_ENTRIES=500
CHAT_CACHE_SEMANTIC_DISTANCE=0.22
# OpenAI rollback settings (uncomment provider/code in app/config.py and app/llm.py to restore).
# LLM_PROVIDER=openai
OPENAI_API_KEY=
# Anthropic remains available as an alternate provider.
ANTHROPIC_API_KEY=
# SUGGESTION_MODEL=         # optional alternate model for the per-client suggestion batch
# LLM_MAX_TOKENS=350

# Source data (defaults point at ../structured_data)
# MERCHANT_CSV_PATH=
# POS_CSV_PATH=

# Defaults to a local SQLite file at backend/rm_copilot.db
# DATABASE_URL=sqlite:///rm_copilot.db

# CORS_ORIGINS=http://localhost:3000

# Audit log (JSON Lines) and chat rate limit per client address per minute (0 disables)
# AUDIT_LOG_PATH=audit_log.jsonl
# AUDIT_LOG_ENABLED=1
# RATE_LIMIT_PER_MIN=30

# NVIDIA NeMo Guardrails on the co-pilots (see app/rails/). The deterministic rails always run when enabled;
# the two LLM-based self-check rails make extra short model calls; deterministic rails remain active as hard checks.
# GUARDRAILS_ENABLED=1
GUARDRAILS_LLM_CHECKS=1
# GUARDRAILS_TIMEOUT=150

# Prompt sizing (see app/prompt_budget.py). The prompt is built to fit PROMPT_TOKENS (defaults to OLLAMA_NUM_CTX); a prompt that cannot fit
# is never sent to the model. Older chat turns are dropped past HISTORY_MAX_CHARS. Portfolio questions list at most PORTFOLIO_ROW_LIMIT
# clients (pitch questions list 5); the counts in the data header always cover all clients.
# PROMPT_TOKENS=8192
# HISTORY_MAX_CHARS=4000
# PORTFOLIO_ROW_LIMIT=8

# Merchant segments (see app/segments.py). Reactivation starts at 5 dormant days because the data has no dormant run longer than 24 days.
# DORMANT_MIN_DAYS=5
# TOP_PERFORMER_SHARE=0.10
# VALUE_HIGH_SHARE=0.33
