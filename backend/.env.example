# Copy to backend/.env and fill in. All values are optional.

# LLM for both co-pilots. Without a key the co-pilots return data-only answers.
LLM_PROVIDER=openai          # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=gpt-4o-mini      # or claude-opus-5-5 for anthropic
# SUGGESTION_MODEL=gpt-4o   # optional stronger model for the per-client suggestion batch
# LLM_MAX_TOKENS=1500

# Source data (defaults point at ../structured_data)
# MERCHANT_CSV_PATH=
# POS_CSV_PATH=

# Defaults to a local SQLite file at backend/rm_copilot.db
# DATABASE_URL=sqlite:///rm_copilot.db

# CORS_ORIGINS=http://localhost:3000

# Audit log (JSON Lines) and chat rate limit per client address per minute (0 disables)
# AUDIT_LOG_PATH=audit_log.jsonl
# AUDIT_LOG_ENABLED=1
# RATE_LIMIT_PER_MIN=30

# NVIDIA NeMo Guardrails on the co-pilots (see app/rails/). The deterministic rails always run when enabled;
# the two LLM-based self-check rails make extra short model calls and can be turned off.
# GUARDRAILS_ENABLED=1
# GUARDRAILS_LLM_CHECKS=1
# GUARDRAILS_TIMEOUT=60
